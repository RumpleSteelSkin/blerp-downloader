# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Generated media outputs / downloaded samples
*.mp4
*.webp
*.mp3
*.gif
*.png

# Don't let logo/icon assets get caught by the rules above (keep them in version control)
!assets/
!assets/*

# PyInstaller / build outputs
build/
dist/
*.spec
*.manifest
version_info.txt

# Temporary files
*.concat.txt
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
